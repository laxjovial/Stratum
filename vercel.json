{
  "version": 2,
  "builds": [
    {
      "src": "packages/frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "packages/backend/src/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "packages/backend/src/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "packages/frontend/$1"
    }
  ]
}
